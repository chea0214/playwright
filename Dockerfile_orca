FROM ubuntu:26.04

# 安装依赖
RUN apt-get update && apt-get install -y \
    git cmake gcc g++ make libgl1-mesa-dev \
    libglu1-mesa-dev libgtk-3-dev libwxgtk3.2-dev \
    && rm -rf /var/lib/apt/lists/*

# 克隆并构建OrcaSlicer
WORKDIR /app
RUN git clone https://gitcode.com/GitHub_Trending/orc/OrcaSlicer
WORKDIR /app/OrcaSlicer
RUN ./build_linux.sh -dsi

# 设置工作目录
WORKDIR /data
ENTRYPOINT ["/app/OrcaSlicer/build/OrcaSlicer"]
CMD ["--help"]
