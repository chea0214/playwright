FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

# orca-slicer CLI运行时依赖（关闭GUI后依赖精简）
RUN apt-get update && apt-get install -y \
    libgl1 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/orca

# 从CI编译产物复制orca-slicer二进制
COPY build/Release/orca-slicer /usr/local/bin/orca-slicer

# 验证
CMD ["orca-slicer", "--help"]
