FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

# 安装 OrcaSlicer AppImage 运行必需依赖
RUN apt-get update && apt-get install -y \
    wget \
    libgl1 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/orca

# 下载官方 v2.4.2 Linux AppImage
RUN wget -q https://github.com/SoftFever/OrcaSlicer/releases/download/v2.4.2/OrcaSlicer-v2.4.2-linux-x64.AppImage \
    && chmod +x OrcaSlicer-v2.4.2-linux-x64.AppImage \
    # 解压AppImage到 squashfs-root
    && ./OrcaSlicer-v2.4.2-linux-x64.AppImage --appimage-extract

# 将orca-slicer CLI加入PATH
ENV PATH="/opt/orca/squashfs-root/usr/bin:${PATH}"

# 清理安装包，减小镜像大小
RUN rm OrcaSlicer-v2.4.2-linux-x64.AppImage

# 默认测试命令，构建后验证是否正常
CMD ["orca-slicer", "--help"]

